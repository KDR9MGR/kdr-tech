# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
#
# SECURITY: this is a TEMPLATE. Copy it to .env.local (already gitignored via
# .env*.local) and fill in real values there. Never put real keys in this file
# — it is committed to git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
