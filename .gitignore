# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# next-sitemap (generated by the postbuild script, not source)
/public/sitemap*.xml
/public/robots.txt

# production
/build

# misc
.DS_Store
*.pem

# Claude Code local settings
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
local.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# never commit key material
key
key.pub
